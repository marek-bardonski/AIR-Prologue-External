{
  "//": "Weather kinds and their weights by season. Prologue design values (26.09.2026), CDDA's weather kinds as the model. Weather is derived in six-hour blocks from the run's seed; snow cover and ice are replayed from the same dice, so nothing here is saved. Code: src/game/weather/Weather.js.",
  "blockHours": 6,
  "stickiness": 0.55,
  "kinds": {
    "clear":    { "name": "Clear",    "tempDeltaC": 0,  "windMs": 2,  "wetPerHour": 0,   "travelFactor": 1,   "sightRadius": null, "encounterFactor": 1,   "outdoorWork": true,  "travelEncounters": true,  "precipitationMmPerHour": 0,   "snowCmPerHour": 0,   "glyph": "sun" },
    "overcast": { "name": "Overcast", "tempDeltaC": -1, "windMs": 3,  "wetPerHour": 0,   "travelFactor": 1,   "sightRadius": null, "encounterFactor": 1,   "outdoorWork": true,  "travelEncounters": true,  "precipitationMmPerHour": 0,   "snowCmPerHour": 0,   "glyph": "cloud" },
    "rain":     { "name": "Rain",     "tempDeltaC": -3, "windMs": 4,  "wetPerHour": 0.3, "travelFactor": 1.15, "sightRadius": null, "encounterFactor": 0.8, "outdoorWork": true,  "travelEncounters": true,  "precipitationMmPerHour": 1.5, "snowCmPerHour": 0,   "glyph": "rain" },
    "storm":    { "name": "Storm",    "tempDeltaC": -4, "windMs": 12, "wetPerHour": 0.6, "travelFactor": 1.4,  "sightRadius": 2,    "encounterFactor": 0.5, "outdoorWork": false, "travelEncounters": true,  "precipitationMmPerHour": 5,   "snowCmPerHour": 0,   "glyph": "storm" },
    "fog":      { "name": "Fog",      "tempDeltaC": -1, "windMs": 1,  "wetPerHour": 0.05, "travelFactor": 1.1, "sightRadius": 1,    "encounterFactor": 1.3, "outdoorWork": true,  "travelEncounters": true,  "precipitationMmPerHour": 0,   "snowCmPerHour": 0,   "glyph": "fog" },
    "sleet":    { "name": "Sleet",    "tempDeltaC": -3, "windMs": 6,  "wetPerHour": 0.45, "travelFactor": 1.25, "sightRadius": null, "encounterFactor": 0.7, "outdoorWork": true,  "travelEncounters": true,  "precipitationMmPerHour": 1.5, "snowCmPerHour": 0.1, "glyph": "sleet" },
    "snow":     { "name": "Snow",     "tempDeltaC": -2, "windMs": 4,  "wetPerHour": 0.1, "travelFactor": 1.2,  "sightRadius": 2,    "encounterFactor": 0.7, "outdoorWork": true,  "travelEncounters": true,  "precipitationMmPerHour": 0.5, "snowCmPerHour": 0.25, "glyph": "snow" },
    "blizzard": { "name": "Blizzard", "tempDeltaC": -5, "windMs": 14, "wetPerHour": 0.2, "travelFactor": 2,    "sightRadius": 1,    "encounterFactor": 0,   "outdoorWork": false, "travelEncounters": false, "precipitationMmPerHour": 1.5, "snowCmPerHour": 0.8, "glyph": "blizzard" }
  },
  "weights": {
    "//": "Per season and phase (early / mid / late, 30-day thirds). Fog only in the dawn block (00:00-06:00 and 06:00-12:00 blocks halve and keep it respectively: see fogBlocks).",
    "spring": {
      "early": { "clear": 25, "overcast": 30, "rain": 22, "storm": 3, "fog": 8, "sleet": 8, "snow": 4 },
      "mid":   { "clear": 32, "overcast": 30, "rain": 24, "storm": 4, "fog": 8, "sleet": 2 },
      "late":  { "clear": 40, "overcast": 28, "rain": 22, "storm": 5, "fog": 5 }
    },
    "summer": {
      "early": { "clear": 48, "overcast": 24, "rain": 18, "storm": 7, "fog": 3 },
      "mid":   { "clear": 55, "overcast": 20, "rain": 15, "storm": 8, "fog": 2 },
      "late":  { "clear": 50, "overcast": 24, "rain": 16, "storm": 7, "fog": 3 }
    },
    "autumn": {
      "early": { "clear": 42, "overcast": 28, "rain": 20, "storm": 4, "fog": 6 },
      "mid":   { "clear": 32, "overcast": 32, "rain": 22, "storm": 3, "fog": 8, "sleet": 3 },
      "late":  { "clear": 26, "overcast": 32, "rain": 14, "storm": 2, "fog": 6, "sleet": 10, "snow": 10 }
    },
    "winter": {
      "early": { "clear": 28, "overcast": 34, "sleet": 6, "snow": 26, "blizzard": 6 },
      "mid":   { "clear": 30, "overcast": 28, "snow": 30, "blizzard": 12 },
      "late":  { "clear": 30, "overcast": 32, "sleet": 8, "snow": 24, "blizzard": 6 }
    }
  },
  "fogBlocks": [0, 1],
  "snow": {
    "//": "Snow on the ground, in centimetres, replayed day by day from the seed: what fell that day minus what melted (meltCmPerDegreeDay times the day's mean above 0 C). Rain on snow melts it faster.",
    "meltCmPerDegreeDay": 1.2,
    "settlePerDay": 0.05,
    "rainMeltCm": 2,
    "maxCm": 50,
    "travelPerCm": { "field": 0.02, "farm": 0.02, "hills": 0.02, "orchard": 0.02, "forest": 0.01, "dense_forest": 0.01, "road": 0.005 },
    "travelFactorMax": 2.5,
    "searchFactorFromCm": 5,
    "searchFactor": 1.3,
    "gatherMinCm": 5
  },
  "ice": {
    "//": "Rivers and lakes freeze once the running seven-day mean is under freezeMeanC and thaw again above thawMeanC. Frozen water is walked at the field's time times travelFactor.",
    "runningDays": 7,
    "freezeMeanC": -3,
    "thawMeanC": 2,
    "travelFactor": 1.2
  },
  "mud": {
    "//": "Fields and farms after a storm, or through the thaw of early spring.",
    "travelFactor": 1.2,
    "afterStormHours": 24,
    "thawSeasonDays": 20
  }
}
