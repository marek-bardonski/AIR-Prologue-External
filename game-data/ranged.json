{
  "//": "Distance in a fight, and what it takes to open or close it. Prologue design values.",
  "source": "AIR design, 18.09.2026, field widened to 15 steps 20.09.2026. The fight has no map: distance is a single number of steps between the two sides.",
  "distance": {
    "//": "The field is 15 steps deep so a bow has somewhere to shoot from. Everything measured per step below was rescaled with it: a longer lane must not quietly multiply the odds of getting away.",
    "min": 1,
    "max": 15,
    "escapeSteps": 16,
    "nightBias": -3,
    "terrainBias": {
      "field": 3,
      "road": 3,
      "lake": 3,
      "river": 3,
      "farm": 3,
      "hills": 0,
      "orchard": 0,
      "campsite": 0,
      "forest": -3,
      "ruins": -3,
      "logging_camp": -3,
      "fishing_dock": -3,
      "dense_forest": -5,
      "house": -5,
      "shop": -5,
      "gas_station": -5,
      "roadside_garage": -5,
      "medical_clinic": -5,
      "railway_depot": -5,
      "electrical_workshop": -5,
      "military_checkpoint": -5,
      "ranger_station": -5,
      "home": -5
    }
  },
  "movement": {
    "//": "Move-point cost of one player action, and how many steps it is worth. Steps per action scale with the depth of the field, so crossing it still takes a handful of actions and a melee survivor is not made to walk for minutes.",
    "walkCost": 60,
    "walkSteps": 1,
    "runCost": 100,
    "runSteps": 3,
    "closeCost": 60,
    "closeSteps": 5,
    "runStepsMin": 1,
    "runStepsMax": 6,
    "walkStamina": 1.0,
    "runStaminaPerStep": 4.0,
    "//runStaminaPerMove": "Prologue rule (27.09.2026): a move made at a run (BACK AWAY, the old footrace) costs this much stamina whatever the steps it covers; the steps still depend on speed, legs, wounds and load, the cost does not. runStaminaPerStep is kept only for fights saved by older builds.",
    "runStaminaPerMove": 8.0
  },
  "enemy": {
    "//": "What it costs an enemy to cross one step, and how long its wind holds out.",
    "closeCost": 100,
    "stamina": 60,
    "tiredCloseMultiplier": 2.0,
    "injurySpeedFloor": 0.5,
    "meleeSlots": 2,
    "packDeathMorale": 20,
    "maxPack": 4,
    "//flee": "An enemy that wants out (harmless, a skittish animal that bolted, or one routed by its wounds) spends fleeCost move points per attempt at its closing speed: it opens fleeSteps, then gets away with fleeBaseChance + fleePerStep x its distance, and for certain once it stands at distance.escapeSteps.",
    "fleeCost": 250,
    "fleeSteps": 3,
    "fleeBaseChance": 0.15,
    "fleePerStep": 0.0375,
    "temperament": {
      "//": "Prologue: wildlife may reconsider at the end of an action; harmless creatures and machines never turn aggressive this way.",
      "attackToFlee": 0.035,
      "failedEscapeToAttack": 0.04,
      "perFailedEscape": 0.02,
      "maxTurnChance": 0.12,
      "cooldownActions": 2
    }
  },
  "throwing": {
    "//": "Throwing a rock or a spear: heavier things fly shorter and cost more to loose. A thrown thing stays a close-quarters answer - past five steps you need a bow.",
    "baseCost": 80,
    "costPerKg": 40,
    "baseRange": 4.0,
    "rangePerKg": 1.5,
    "minRange": 1,
    "maxRange": 5,
    "stamina": 2.0,
    "accuracyPerStep": 1.0,
    "breakChance": 0.15,
    "alsoThrowable": [
      "steel_chunk",
      "lc_steel_chunk",
      "sharp_rock",
      "javelin_fletched_bronze"
    ],
    "neverThrow": [
      "log",
      "wooden_post_long",
      "plank_long",
      "anvil",
      "anvil_crude",
      "anvil_scavenged",
      "anvil_stump"
    ]
  },
  "launchers": {
    "//": "CDDA's ranged damage is on a different scale to its melee damage, so the Prologue states its own here: damage is comparable to a melee weapon's one number, range is in steps. Anything not listed falls back to (ranged_damage + ammo damage) * ammo multiplier * fallbackScale, reaching ranged range / fallbackRangeDivisor steps.",
    "fallbackScale": 1.6,
