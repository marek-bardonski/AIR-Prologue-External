  "breakAway": {
    "//": "Getting away is not only a footrace: you can also go to ground, put something between you and it, or throw it off. Each attempt to move away carries this chance to break contact outright, better the more ground you already have and the less it cares about you.",
    "baseChance": 0.03,
    "perStep": 0.013,
    "runBonus": 0.03,
    "maxChance": 0.5,
    "coverBonus": {
      "dense_forest": 0.1,
