  "irrigation": {
    "//": "A ditch from a river or lake waters every plot on the tile for good. The water may be next door, or up to span.maxHexes hexes of any ground away: the ditch is then dug across each of them as well, span.minutes more per hex by its ground (default for anything unlisted), and ground listed in span.qualities needs those tools too (roots to cut). A ditch across other hexes only runs over ground already seen. Code: Farming.irrigationRoute.",
    "minutes": 360,
    "span": {
      "maxHexes": 2,
      "minutes": {
        "default": 240,
        "hills": 420,
        "forest": 420,
        "dense_forest": 600
      },
      "qualities": {
        "forest": [
          [
            [
              "AXE",
              1
            ]
          ]
        ],
        "dense_forest": [
          [
            [
              "AXE",
              1
            ]
          ]
        ]
      }
    },
    "qualities": [
      [
        [
          "DIG",
          2
        ]
      ]
    ],
    "sources": [
      "river",
      "lake"
    ]
  },
  "rain": {
    "//": "Weather that waters every bed on a farm without a ditch, as a full watering that lasts the terrain's waterDays from the last hour it fell. Checked hour by hour as the clock passes (Farming.tick).",
    "weathers": [
      "rain",
      "storm"
    ]
  },
  "water": {
    "//": "Watering by hand from containers within reach; lasts the terrain's waterDays. items are poured in the order listed (worst water first) and may be mixed. A watering may cover only part of a patch; the harvest roll and the pests count it as watered from caredShare up.",
    "unitsPerPlant": 0.5,
    "caredShare": 0.5,
    "items": [
      "water_murky",
      "water",
      "water_purifying",
      "water_clean"
    ]
  },
  "fertilizers": {
    "//": "Power feeds the growth speed and the yield bands; one unit covers plantsPerUnit plants, and it is used up after lastsDays, after which the bed can be fed again.",
    "plantsPerUnit": 5,
    "lastsDays": 10,
    "power": {
      "fertilizer_commercial": 1,
      "meal_bone": 0.7,
      "chem_saltpetre": 0.6,
      "spoilage": 0.4,
      "ash": 0.3,
      "feces_manure": 0.6,
      "feces_cow": 0.5
    }
  },
  "bands": {
    "//": "Rolled once when a plot ripens. Bumper needs both water and fertilizer; the shifts move weight when the plot was cared for.",
    "order": [
      "poor",
      "normal",
      "good",
      "bumper"
    ],
    "yield": {
      "poor": 0.6,
      "normal": 1,
      "good": 1.3,
      "bumper": 1.6
    },
    "weight": {
      "poor": 25,
      "normal": 55,
      "good": 20,
      "bumper": 0
    },
    "requires": {
      "bumper": [
        "water",
        "fertilizer"
      ]
    },
    "shifts": {
      "water": {
        "poor": -8,
        "good": 6,
        "bumper": 4
      },
      "fertilizer": {
        "poor": -8,
        "good": 8,
        "bumper": 6
      },
      "soil": {
        "poor": -5,
        "good": 4
      }
    },
    "goodSoil": 1.1
  },
  "pests": {
    "//": "Rolled every intervalDays of growth; a watered and fertilized plot is checked at half the chance.",
    "intervalDays": 3,
    "chance": 0.06,
    "caredMultiplier": 0.5,
    "lossPerDay": 0.04,
    "maxLoss": 0.5
  },
  "overripe": {
    "//": "After the crop's ripe window closes the harvest rots away; withered is all that is left.",
