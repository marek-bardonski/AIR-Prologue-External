{
  "//": "Farming on world tiles: which ground can be worked, what grows on it, how long it takes and what it costs. Crop grow times come from the seeds' own CDDA data and are scaled by growth.scale; everything else is Prologue tuning.",
  "plantsPerPlot": 25,
  "growth": {
    "//": "growDays = seed grow time * scale. Speed = 1 + waterBonus * water coverage + fertilizerBonus * fertilizer power, capped at maxSpeed.",
    "scale": 0.23,
    "waterBonus": 0.35,
    "fertilizerBonus": 0.5,
    "maxSpeed": 2,
    "stages": {
      "seedling": 0.2,
      "growing": 0.6,
      "maturing": 1
    }
  },
  "climate": {
    "//": "The growing season (26.09.2026). Crops grow only on days whose mean air is at least growMinC (Climate.isGrowingDay); planting is refused while the day's mean is under plantMinC. A frost (the air under frostC at any hourly look, or a frosty dawn) kills every bed that is not yet ripe unless its crop is frostHardy (crops.<seed>.frostHardy: roots, brassica-like greens, cereals, garlic); a ripe or overripe tender bed stands frostGraceDays more and then is gone. Code: src/game/farming/Farming.js.",
    "growMinC": 5,
    "plantMinC": 5,
    "frostC": 0,
    "frostGraceDays": 3
  },
  "labour": {
    "//": "Productive minutes before activitySpeed; per plant unless stated.",
    "tillPerPlant": 4,
    "plantPerPlant": 1.5,
    "waterPerPlant": 0.5,
    "tendPerPlant": 0.6,
    "harvestPerPlant": 2,
    "uprootPerPlant": 0.8,
    "fertilizePerPlot": 10,
    "grainHarvestMultiplier": 0.5
  },
  "tools": {
    "//": "Tilling needs DIG 1; better digging tools make it faster. Grain harvests are halved by a GRASS_CUT tool at grassCutLevel.",
    "tillQuality": "DIG",
    "tillMinimum": 1,
    "tillSpeed": {
      "2": 0.7,
      "3": 0.5
    },
    "grainHarvestQuality": "GRASS_CUT",
    "grainHarvestLevel": 2,
    "tillItems": {
      "hoe": 0.5,
      "hoe_stone": 0.65,
      "hoe_wooden": 0.8
    },
    "//tillItems": "The right tool for the job, best first: a steel hoe halves the work, a stone one nearly so, a wooden one still beats bare hands and a digging stick."
  },
